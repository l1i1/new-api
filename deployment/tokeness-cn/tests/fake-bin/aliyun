#!/usr/bin/env bash
set -Eeuo pipefail

# Stateful fake for the `aliyun` CLI used by deploy-test.sh. The fake parses
# ModifyEciScalingConfiguration arguments back into the response shape so the
# deployment's full-config readback check exercises real preservation logic.
# Environment and registry values are redacted from invocation logs.

state_dir="${TOKENESS_TEST_STATE_DIR:?TOKENESS_TEST_STATE_DIR not set}"
mkdir -p "$state_dir"
state="$state_dir/state.json"
if [[ ! -f "$state" ]]; then
  printf '%s\n' '{"desired":1,"instances":[],"config":{"ScalingConfigurationId":"asc-test","Containers":[]}}' > "$state"
fi

svc="${1:-}"
shift || true
action="${1:-}"
shift || true
cmd="$svc $action"

redact_and_log() {
  local file="$1" previous='' arg safe
  shift
  printf '%s' "$cmd" >> "$file"
  for arg in "$@"; do
    if [[ "$previous" =~ ^--(Container|InitContainer)\.[0-9]+\.(EnvironmentVar|InitContainerEnvironmentVar)\.[0-9]+\.Value$ ]] \
      || [[ "$previous" =~ ^--ImageRegistryCredential\.[0-9]+\.(Server|UserName|Password)$ ]]; then
      safe='[REDACTED]'
    else
      safe="$arg"
    fi
    printf ' %s' "$safe" >> "$file"
    previous="$arg"
  done
  printf '\n' >> "$file"
}

redact_and_log "$state_dir/aliyun-calls.log" "$@"

flag_value() {
  local flag="$1" i
  for ((i = 2; i <= $#; i++)); do
    if [[ "${!i}" == "$flag" ]]; then
      local j=$((i + 1))
      printf '%s\n' "${!j}"
      return 0
    fi
  done
  return 1
}

state_update() {
  local tmp="$state.tmp"
  jq "$@" "$state" > "$tmp" && mv "$tmp" "$state"
}

describe_config() {
  python3 - "$state" <<'PY'
import json
import os
import sys

state_path = sys.argv[1]
with open(state_path, encoding="utf-8") as stream:
    state = json.load(stream)

state["describe_count"] = state.get("describe_count", 0) + 1
config = state.get("config")
if not isinstance(config, dict):
    config = {
        "ScalingConfigurationId": "asc-test",
        "Cpu": 2.0,
        "Memory": 4.0,
        "RestartPolicy": "Always",
        "SecurityGroupId": "sg-test",
        "AutoCreateEip": True,
        "EipBandwidth": 200,
        "ImageRegistryCredential": [{
            "Server": "docker.cnb.cool",
            "UserName": "cnb",
            "Password": "test-registry-password",
        }],
        "Containers": [{
            "Name": "newapi",
            "Image": state.get("image", ""),
            "ImagePullPolicy": "IfNotPresent",
            "EnvironmentVars": state.get("envs", []),
        }],
    }
    state["config"] = config

# Simulate a provider that accepted a replacement but dropped one field on the
# first readback. The next restore readback is complete again.
if (
    os.environ.get("TOKENESS_TEST_READBACK_DRIFT_ONCE", "0") == "1"
    and state.get("modify_count", 0) > 0
    and state.get("drift_count", 0) == 0
):
    containers = config.get("Containers")
    if isinstance(containers, list) and containers:
        envs = containers[0].get("EnvironmentVars")
        if isinstance(envs, list) and envs:
            containers[0]["EnvironmentVars"] = envs[:-1]
    state["drift_count"] = 1

with open(state_path, "w", encoding="utf-8") as stream:
    json.dump(state, stream, ensure_ascii=False, separators=(",", ":"))
    stream.write("\n")

print(json.dumps({"ScalingConfigurations": [config]}, ensure_ascii=False, separators=(",", ":")))
PY
}

modify_config() {
  [[ "${TOKENESS_TEST_MODIFY_FAIL:-0}" == "1" ]] && exit 1

  local modify_count
  modify_count="$(jq -r '.modify_count // 0' "$state" | tr -d '\r')"
  modify_count=$((modify_count + 1))
  state_update --argjson n "$modify_count" '.modify_count = $n'

  python3 - "$state" "$@" <<'PY'
import json
import sys

state_path = sys.argv[1]
argv = sys.argv[2:]
with open(state_path, encoding="utf-8") as stream:
    state = json.load(stream)
old = state.get("config")
if not isinstance(old, dict):
    old = {}
config = {"ScalingConfigurationId": old.get("ScalingConfigurationId", "asc-test")}


def scalar(flag, value):
    name = flag.rsplit(".", 1)[-1].lstrip("-")
    if name.isdigit() and ".Port." in flag:
        try:
            return int(value)
        except ValueError:
            return value
    if name in {
        "AutoCreateEip", "AutoMatchImageCache", "CostOptimization", "DataCacheBurstingEnabled", "Override",
        "ReadOnly", "ReadOnlyRootFilesystem", "Stdin", "StdinOnce", "Tty",
    }:
        return value.lower() == "true"
    if name in {
        "ActiveDeadlineSeconds", "CpuOptionsCore", "CpuOptionsThreadsPerCore",
        "DataCacheProvisionedIops", "EgressBandwidth", "EipBandwidth", "EphemeralStorage", "Gpu",
        "IngressBandwidth", "Ipv6AddressCount", "LoadBalancerWeight", "Port", "RunAsUser",
        "TerminationGracePeriodSeconds", "FailureThreshold", "InitialDelaySeconds",
        "PeriodSeconds", "SuccessThreshold", "TimeoutSeconds",
    } or name.endswith("Port"):
        try:
            return int(value)
        except ValueError:
            return value
    if name in {"Cpu", "Memory", "SpotPriceLimit"}:
        try:
            return float(value)
        except ValueError:
            return value
    return value


def ensure_list(parent, key, index):
    values = parent.setdefault(key, [])
    while len(values) <= index:
        values.append({})
    return values[index]


def set_nested(parent, parts, value):
    """Set key/index paths such as Port.1.Protocol or Command.1."""
    if not parts:
        return
    key = parts[0]
    if len(parts) == 1:
        parent[key] = value
        return
    next_part = parts[1]
    if next_part.isdigit():
        values = parent.setdefault(key, [])
        index = int(next_part) - 1
        while len(values) <= index:
            values.append({} if len(parts) > 2 else None)
        if len(parts) == 2:
            values[index] = value
        else:
            if not isinstance(values[index], dict):
                values[index] = {}
            set_nested(values[index], parts[2:], value)
        return
    child = parent.setdefault(key, {})
    if not isinstance(child, dict):
        child = {}
        parent[key] = child
    set_nested(child, parts[1:], value)


def set_flat_lifecycle(container, name, value):
    for prefix, handler_name, kind in (
        ("LifecyclePostStartHandlerHttpGet", "LifecyclePostStartHandler", "HttpGet"),
        ("LifecyclePostStartHandlerTcpSocket", "LifecyclePostStartHandler", "TcpSocket"),
        ("LifecyclePreStopHandlerHttpGet", "LifecyclePreStopHandler", "HttpGet"),
        ("LifecyclePreStopHandlerTcpSocket", "LifecyclePreStopHandler", "TcpSocket"),
    ):
        if name.startswith(prefix):
            field = name[len(prefix):]
            container.setdefault(handler_name, {}).setdefault(kind, {})[field] = value
            return True
    return False


def put(parts, value):
    if not parts:
        return
    if parts[0] == "Container":
        container = ensure_list(config, "Containers", int(parts[1]) - 1)
        rest = parts[2:]
        if rest and rest[0] == "EnvironmentVar":
            env = ensure_list(container, "EnvironmentVars", int(rest[1]) - 1)
            env[rest[2]] = value
            return
        if rest and rest[0] == "VolumeMount":
            mount = ensure_list(container, "VolumeMount", int(rest[1]) - 1)
            set_nested(mount, rest[2:], value)
            return
        if rest and rest[0] in {"LifecyclePostStartHandlerExec", "LifecyclePreStopHandlerExec"}:
            handler_name = (
                "LifecyclePostStartHandler"
                if rest[0].startswith("LifecyclePostStart")
                else "LifecyclePreStopHandler"
            )
            command = container.setdefault(handler_name, {}).setdefault("Exec", {}).setdefault("Command", [])
            index = int(rest[1]) - 1
            while len(command) <= index:
                command.append("")
            command[index] = value
            return
        if rest and set_flat_lifecycle(container, rest[0], value):
            return
        set_nested(container, rest, value)
        return
    if parts[0] == "InitContainer":
        container = ensure_list(config, "InitContainers", int(parts[1]) - 1)
        rest = parts[2:]
        if rest and rest[0] == "InitContainerEnvironmentVar":
            env = ensure_list(container, "EnvironmentVars", int(rest[1]) - 1)
            env[rest[2]] = value
            return
        if rest and rest[0] == "VolumeMount":
            mount = ensure_list(container, "VolumeMount", int(rest[1]) - 1)
            set_nested(mount, rest[2:], value)
            return
        set_nested(container, rest, value)
        return
    if parts[0] == "ImageRegistryCredential":
        item = ensure_list(config, "ImageRegistryCredential", int(parts[1]) - 1)
        item[parts[2]] = value
        return
    if parts[0] in {"AcrRegistryInfo", "HostAliase", "SecurityContextSysctl", "Tag", "Volume"}:
        item = ensure_list(config, parts[0], int(parts[1]) - 1)
        set_nested(item, parts[2:], value)
        return
    if parts[0] == "DnsConfigNameServer":
        config.setdefault("DnsConfig", {}).setdefault("NameServer", []).append(value)
        return
    if parts[0] == "DnsConfigSearch":
        config.setdefault("DnsConfig", {}).setdefault("Search", []).append(value)
        return
    if parts[0] == "DnsConfigOption":
        option = ensure_list(config.setdefault("DnsConfig", {}), "Option", int(parts[1]) - 1)
        option[parts[2]] = value
        return
    if parts[0] in {"InstanceType", "NtpServer"}:
        config.setdefault(parts[0], []).append(value)
        return
    set_nested(config, parts, value)


index = 0
while index < len(argv):
    flag = argv[index]
    index += 1
    if not flag.startswith("--"):
        continue
    if flag in {"--ScalingConfigurationId", "--region"}:
        if index < len(argv):
            index += 1
        continue
    if index >= len(argv):
        break
    raw_value = argv[index]
    index += 1
    put(flag[2:].split("."), scalar(flag, raw_value))

state["config"] = config
containers = config.get("Containers")
if isinstance(containers, list) and containers:
    state["image"] = containers[0].get("Image", "")
    state["envs"] = containers[0].get("EnvironmentVars", [])
with open(state_path, "w", encoding="utf-8") as stream:
    json.dump(state, stream, ensure_ascii=False, separators=(",", ":"))
    stream.write("\n")
PY
  printf '%s\n' '{"RequestId":"fake"}'
}

case "$cmd" in
  # The tier's scale-in alarm: deploy.sh looks it up by name, suspends it for the
  # duration of a rollout and re-enables it on exit. The fake records the state so
  # a case can assert the whole suspend -> rollout -> resume sequence.
  "ess DescribeAlarms")
    # The alarm's enable state comes from the state file, not a constant: a
    # release that suspends an already-disabled alarm must NOT re-enable it at
    # resume, and a test must be able to seed the disabled case.
    enable=true
    if [[ -n "$(jq -r '.scale_in_alarm.state // empty' "$state" 2>/dev/null | tr -d '\r')" ]]; then
      enable="$(jq -r 'if .scale_in_alarm.state == "enabled" then true else false end' "$state" 2>/dev/null | tr -d '\r')"
    fi
    name="${TOKENESS_TEST_SCALE_IN_ALARM_NAME:-cpu-in-25}"
    printf '{"AlarmList":{"Alarm":[{"Name":"%s","AlarmTaskId":"alarm-test-1","Enable":%s}]}}\n' "$name" "$enable"
    ;;
  "ess DisableAlarm"|"ess EnableAlarm")
    id="$(flag_value --AlarmTaskId "$@" | tr -d '\r')"
    event=disabled
    [[ "$cmd" == "ess EnableAlarm" ]] && event=enabled
    printf '%s\n' "ess $cmd --AlarmTaskId $id" >> "$state_dir/alarm-calls.log"
    state_update --arg e "$event" --arg i "$id" '.scale_in_alarm = {id: $i, state: $e}'
    printf '{"RequestId":"fake"}\n'
    ;;
  "ess ModifyScalingGroup")
    desired="$(flag_value --DesiredCapacity "$@" | tr -d '\r')"
    # Capacity boundaries are enforced: the real ESS refuses a DesiredCapacity
    # outside [MinSize, MaxSize]. A fake that ignored them let tests bless
    # releases the production API would have rejected outright.
    group_max="$(jq -r '.max_size // 4' "$state" | tr -d '\r')"
    if (( desired > group_max || desired < 1 )); then
      printf '{"Code":"InvalidParameter","Message":"DesiredCapacity %s is out of range [1, %s]"}\n' "$desired" "$group_max" >&2
      exit 1
    fi
    before_count="$(jq -c '.instances | length' "$state" | tr -d '\r')"
    # Evidence snapshot for the tests (#12): what the drain marker and the relay
    # upstream looked like AT the moment the group was resized. End-state
    # assertions cannot prove the parking happened; this can.
    snap="$state_dir/modify-snapshots"
    mkdir -p "$snap" 2>/dev/null || true
    snap_n="$(ls "$snap" 2>/dev/null | wc -l)"
    {
      printf 'desired=%s before=%s\n' "$desired" "$before_count"
      printf -- '--- drain marker ---\n'
      if [[ -n "${SHRINK_DRAIN_PATH:-}" && -f "$SHRINK_DRAIN_PATH" ]]; then cat "$SHRINK_DRAIN_PATH"; else printf '(absent)\n'; fi
      printf -- '--- relay upstream ---\n'
      if [[ -n "${ECS_UPSTREAM_CONF:-}" && -f "$ECS_UPSTREAM_CONF" ]]; then cat "$ECS_UPSTREAM_CONF"; else printf '(absent)\n'; fi
    } > "$snap/modify-$(( snap_n + 1 )).log" 2>/dev/null || true
    # A scale-out SUPERSEDES an in-flight scale-in, exactly as the real ESS does:
    # the instances the pending removal had already detached come back and no
    # replacement is created for them. This is the behaviour that killed the
    # 2026-10-09 release - a rollout that scaled out while its previous scale-in
    # was still terminating got no new instance at all.
    if (( $(jq '.instances | length' "$state" | tr -d '\r') < desired )); then
      state_update '.instances = ((.pending_removal.instances // []) + .instances)
                    | .pending_removal = null'
    fi
    while (( $(jq '.instances | length' "$state" | tr -d '\r') < desired )); do
      # Monotonic numbering, not "current length": a batch rollout scales up and
      # down repeatedly, and a length-derived index would reuse an ID and a
      # private IP on the second round - inventing a collision the real ESS
      # never produces. Starting from a one-instance fixture this still yields
      # eci-new-1/10.0.0.241 first, which is what the existing cases expect.
      n="$(jq '.next_index // 1' "$state" | tr -d '\r')"
      state_update --argjson n "$n" --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '.instances += [{
        "InstanceId": ("eci-new-" + ($n | tostring)),
        "PrivateIpAddress": ("10.0.0." + (240 + $n | tostring)),
        "HealthStatus": "Healthy",
        "LifecycleState": "InService",
        "CreatedTime": $created,
        "ZoneId": "cn-shanghai-l"
      }] | .next_index = ($n + 1)'
    done
    # A scale-in detaches the oldest instances, but the group keeps REPORTING
    # them until the platform finishes terminating them
    # (TOKENESS_TEST_SCALE_IN_LAG_SECONDS, 0 by default so every earlier case
    # keeps its previous behaviour).
    lag="${TOKENESS_TEST_SCALE_IN_LAG_SECONDS:-0}"
    while (( $(jq '.instances | length' "$state" | tr -d '\r') > desired )); do
      # ESS's OldestInstance policy removes the earliest-joined instance, not
      # the first array member: the fake state keeps .instances in join order,
      # so this is also where a caller that assumed array order breaks.
      if [[ "$lag" =~ ^[1-9][0-9]*$ ]]; then
        state_update --argjson until "$(( $(date +%s) + lag ))" '
          .pending_removal = {until: $until, instances: ((.pending_removal.instances // []) + [(.instances | sort_by(.CreatedTime))[0]])}
          | .instances = (.instances | sort_by(.CreatedTime) | .[1:])'
      else
        state_update '.instances = (.instances | sort_by(.CreatedTime) | .[1:])'
      fi
    done
    # External scale-out injection (test-only): mimic the tier's alarm adding
    # instances while the rollout is running.
    ext="${TOKENESS_TEST_EXTERNAL_SCALEOUT:-}"
    if [[ "$ext" =~ ^[1-9][0-9]*$ && ! -f "$state_dir/.external_scaleout_done" ]] \
       && (( $(jq -c '.instances | length' "$state" | tr -d '\r') < before_count )); then
      touch "$state_dir/.external_scaleout_done"
      # A separate counter and IP range: these instances are NOT the rollout's,
      # so they must not consume the monotonic index the round's own instances
      # are numbered from. 10.0.0.201/202 are pre-listed in the case's relay
      # fixture, which is what the entry's fleet sync would do in production.
      j=0
      while (( j < ext )); do
        e="$(jq '.ext_index // 1' "$state" | tr -d '\r')"
        state_update --argjson e "$e" --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '.instances += [{
          "InstanceId": ("eci-ext-" + ($e | tostring)),
          "PrivateIpAddress": ("10.0.0." + (200 + $e | tostring)),
          "HealthStatus": "Healthy",
          "LifecycleState": "InService",
          "CreatedTime": $created,
          "ZoneId": "cn-shanghai-l"
        }] | .ext_index = ($e + 1)'
        j=$(( j + 1 ))
      done
      printf '%s\n' "external scale-out injected: $ext instance(s)" >> "$state_dir/external-scaleout.log"
    fi

    state_update --argjson d "$desired" '.desired = $d'
    printf '%s\n' '{"RequestId":"fake"}'
    ;;
  "ess DescribeScalingGroups")
    # DesiredCapacity drives how far a rollout grows the tier and what it
    # returns to; before any ModifyScalingGroup call it is the live instance
    # count, which is what a real group reports for its steady state.
    # max_size is per-case: a batch rollout is bounded by it, so the "no
    # headroom" refusal and the multi-round path both need it under test.
    # RemovalPolicies mirrors the real group this tier runs (verified by the
    # release's oldest-instance selection before it dares to predict victims).
    jq --arg rp "${TOKENESS_TEST_REMOVAL_POLICY:-OldestInstance}" '{ScalingGroups: {ScalingGroup: [{
      ScalingGroupId: "asg-test",
      MinSize: 1,
      MaxSize: (.max_size // 4),
      DesiredCapacity: (.desired // (.instances | length)),
      LifecycleState: "Active",
      RemovalPolicies: {RemovalPolicy: [$rp]}
    }]}}' "$state"
    ;;
  "ess DescribeScalingInstances")
    # Instances a pending scale-in has detached are still REPORTED until the lag
    # expires, then the pending record is dropped - the same asynchronous window
    # the real ESS has. Detached instances report LifecycleState "Removing"
    # (they are gone from InService the moment ESS picks them, but not gone
    # from the group until termination finishes), which is what makes a gate
    # that watches full departure differ from one that watches InService. The
    # response REVERSES the state's join order: the real API makes no ordering
    # promise, and callers were silently sorting by it before the
    # CreatedTime-based selection landed.
    state_update --argjson now "$(date +%s)" '
      if (.pending_removal != null) and (.pending_removal.until <= $now)
      then .pending_removal = null else . end' >/dev/null 2>&1 || true
    jq '{ScalingInstances: {ScalingInstance:
          ([((.pending_removal.instances // [])[] | {
            InstanceId, PrivateIpAddress,
            HealthStatus: "Healthy",
            LifecycleState: "Removing",
            CreatedTime: (.CreatedTime // "1970-01-01T00:00:00Z"),
            ZoneId: (.ZoneId // "cn-shanghai-l")
          })] + [(.instances[] | {
            InstanceId, PrivateIpAddress,
            HealthStatus: "Healthy",
            LifecycleState: "InService",
            CreatedTime: (.CreatedTime // "1970-01-01T00:00:00Z"),
            ZoneId: (.ZoneId // "cn-shanghai-l")
          })] | reverse)}}' "$state"
    ;;
  "ess DescribeEciScalingConfigurations")
    describe_config
    ;;
  "ess ModifyEciScalingConfiguration")
    redact_and_log "$state_dir/modify-args.txt" "$@"
    modify_config "$@"
    ;;
  "eci DescribeContainerLog")
    jq -n --arg c "$(jq -r '.logContent // "ready"' "$state")" '{Content: $c}'
    ;;
  "eci DescribeContainerGroups")
    # Each instance gets a deterministic derived public IP (last octet of its
    # private address) so ensure_eip_in_bandwidth_package can find it. The
    # TOKENESS_TEST_NO_PUBLIC_IP flag simulates an attach still in flight.
    noip="${TOKENESS_TEST_NO_PUBLIC_IP:-0}"
    jq --arg noip "$noip" '{ContainerGroups: [.instances[] | {
      ContainerGroupId: .InstanceId,
      Status: "Running",
      InternetIp: (if $noip == "1" then null
                   else ("203.0.113." + (.PrivateIpAddress | split(".")[3])) end)
    }]}' "$state"
    ;;
  "vpc DescribeEipAddresses")
    if [[ "${TOKENESS_TEST_EIP_ABSENT:-0}" == "1" ]]; then
      printf '%s\n' '{"EipAddresses":{"EipAddress":[]}}'
    else
      pkg="$(jq -r '.eip_package_id // ""' "$state" | tr -d '\r')"
      want="$(flag_value --EipAddress "$@" | tr -d '\r')"
      jq --arg pkg "$pkg" --arg want "$want" '{
        EipAddresses: {EipAddress: [.instances[]
          | {
              IpAddress: ("203.0.113." + (.PrivateIpAddress | split(".")[3])),
              AllocationId: ("eip-" + .InstanceId),
              BandwidthPackageId: $pkg
            }
          | select(($want == "") or (.IpAddress == $want))]}}' "$state"
    fi
    ;;
  "vpc AddCommonBandwidthPackageIp")
    ipid="$(flag_value --IpInstanceId "$@" | tr -d '\r')"
    # Bind semantics: the target allocation must exist, otherwise the fake
    # would paper over a wrong-target regression.
    if [[ -n "$ipid" ]] \
      && ! jq -e --arg id "$ipid" '[.instances[] | "eip-" + .InstanceId] | index($id)' "$state" >/dev/null; then
      echo "ERROR: unknown IpInstanceId $ipid" >&2
      exit 2
    fi
    if [[ "${TOKENESS_TEST_VPC_FAIL:-0}" == "1" ]]; then
      exit 1
    fi
    pkg="$(flag_value --BandwidthPackageId "$@" | tr -d '\r')"
    state_update --arg pkg "$pkg" '.eip_package_id = $pkg'
    printf '%s\n' '{"RequestId":"fake"}'
    ;;
  "eci DeleteContainerGroup")
    id="$(flag_value --ContainerGroupId "$@")"
    state_update --arg id "$id" '.instances |= map(select(.InstanceId != $id))'
    printf '%s\n' '{"RequestId":"fake"}'
    ;;
  *)
    printf '%s\n' '{"RequestId":"fake"}'
    ;;
esac
