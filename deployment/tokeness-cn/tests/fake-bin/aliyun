#!/usr/bin/env bash
set -Eeuo pipefail

# Stateful fake for the `aliyun` CLI used by deploy-test.sh. The fake parses
# ModifyEciScalingConfiguration arguments back into the response shape so the
# deployment's full-config readback check exercises real preservation logic.
# Environment and registry values are redacted from invocation logs.

state_dir="${TOKENESS_TEST_STATE_DIR:?TOKENESS_TEST_STATE_DIR not set}"
mkdir -p "$state_dir"
state="$state_dir/state.json"
if [[ ! -f "$state" ]]; then
  printf '%s\n' '{"desired":1,"instances":[],"config":{"ScalingConfigurationId":"asc-test","Containers":[]}}' > "$state"
fi

svc="${1:-}"
shift || true
action="${1:-}"
shift || true
cmd="$svc $action"

redact_and_log() {
  local file="$1" previous='' arg safe
  shift
  printf '%s' "$cmd" >> "$file"
  for arg in "$@"; do
    if [[ "$previous" =~ ^--(Container|InitContainer)\.[0-9]+\.(EnvironmentVar|InitContainerEnvironmentVar)\.[0-9]+\.Value$ ]] \
      || [[ "$previous" =~ ^--ImageRegistryCredential\.[0-9]+\.(Server|UserName|Password)$ ]]; then
      safe='[REDACTED]'
    else
      safe="$arg"
    fi
    printf ' %s' "$safe" >> "$file"
    previous="$arg"
  done
  printf '\n' >> "$file"
}

redact_and_log "$state_dir/aliyun-calls.log" "$@"

flag_value() {
  local flag="$1" i
  for ((i = 2; i <= $#; i++)); do
    if [[ "${!i}" == "$flag" ]]; then
      local j=$((i + 1))
      printf '%s\n' "${!j}"
      return 0
    fi
  done
  return 1
}

state_update() {
  local tmp="$state.tmp"
  jq "$@" "$state" > "$tmp" && mv "$tmp" "$state"
}

describe_config() {
  python3 - "$state" <<'PY'
import json
import os
import sys

state_path = sys.argv[1]
with open(state_path, encoding="utf-8") as stream:
    state = json.load(stream)

state["describe_count"] = state.get("describe_count", 0) + 1
config = state.get("config")
if not isinstance(config, dict):
    config = {
        "ScalingConfigurationId": "asc-test",
        "Cpu": 2.0,
        "Memory": 4.0,
        "RestartPolicy": "Always",
        "SecurityGroupId": "sg-test",
        "AutoCreateEip": True,
        "EipBandwidth": 200,
        "ImageRegistryCredential": [{
            "Server": "docker.cnb.cool",
            "UserName": "cnb",
            "Password": "test-registry-password",
        }],
        "Containers": [{
            "Name": "newapi",
            "Image": state.get("image", ""),
            "ImagePullPolicy": "IfNotPresent",
            "EnvironmentVars": state.get("envs", []),
        }],
    }
    state["config"] = config

# Simulate a provider that accepted a replacement but dropped one field on the
# first readback. The next restore readback is complete again.
if (
    os.environ.get("TOKENESS_TEST_READBACK_DRIFT_ONCE", "0") == "1"
    and state.get("modify_count", 0) > 0
    and state.get("drift_count", 0) == 0
):
    containers = config.get("Containers")
    if isinstance(containers, list) and containers:
        envs = containers[0].get("EnvironmentVars")
        if isinstance(envs, list) and envs:
            containers[0]["EnvironmentVars"] = envs[:-1]
    state["drift_count"] = 1

with open(state_path, "w", encoding="utf-8") as stream:
    json.dump(state, stream, ensure_ascii=False, separators=(",", ":"))
    stream.write("\n")

print(json.dumps({"ScalingConfigurations": [config]}, ensure_ascii=False, separators=(",", ":")))
PY
}

modify_config() {
  [[ "${TOKENESS_TEST_MODIFY_FAIL:-0}" == "1" ]] && exit 1

  local modify_count
  modify_count="$(jq -r '.modify_count // 0' "$state" | tr -d '\r')"
  modify_count=$((modify_count + 1))
  state_update --argjson n "$modify_count" '.modify_count = $n'

  python3 - "$state" "$@" <<'PY'
import json
import sys

state_path = sys.argv[1]
argv = sys.argv[2:]
with open(state_path, encoding="utf-8") as stream:
    state = json.load(stream)
old = state.get("config")
if not isinstance(old, dict):
    old = {}
config = {"ScalingConfigurationId": old.get("ScalingConfigurationId", "asc-test")}


def scalar(flag, value):
    name = flag.rsplit(".", 1)[-1].lstrip("-")
    if name.isdigit() and ".Port." in flag:
        try:
            return int(value)
        except ValueError:
            return value
    if name in {
        "AutoCreateEip", "AutoMatchImageCache", "CostOptimization", "DataCacheBurstingEnabled", "Override",
        "ReadOnly", "ReadOnlyRootFilesystem", "Stdin", "StdinOnce", "Tty",
    }:
        return value.lower() == "true"
    if name in {
        "ActiveDeadlineSeconds", "CpuOptionsCore", "CpuOptionsThreadsPerCore",
        "DataCacheProvisionedIops", "EgressBandwidth", "EipBandwidth", "EphemeralStorage", "Gpu",
        "IngressBandwidth", "Ipv6AddressCount", "LoadBalancerWeight", "Port", "RunAsUser",
        "TerminationGracePeriodSeconds", "FailureThreshold", "InitialDelaySeconds",
        "PeriodSeconds", "SuccessThreshold", "TimeoutSeconds",
    } or name.endswith("Port"):
        try:
            return int(value)
        except ValueError:
            return value
    if name in {"Cpu", "Memory", "SpotPriceLimit"}:
        try:
            return float(value)
        except ValueError:
            return value
    return value


def ensure_list(parent, key, index):
    values = parent.setdefault(key, [])
    while len(values) <= index:
        values.append({})
    return values[index]


def set_nested(parent, parts, value):
    """Set key/index paths such as Port.1.Protocol or Command.1."""
    if not parts:
        return
    key = parts[0]
    if len(parts) == 1:
        parent[key] = value
        return
    next_part = parts[1]
    if next_part.isdigit():
        values = parent.setdefault(key, [])
        index = int(next_part) - 1
        while len(values) <= index:
            values.append({} if len(parts) > 2 else None)
        if len(parts) == 2:
            values[index] = value
        else:
            if not isinstance(values[index], dict):
                values[index] = {}
            set_nested(values[index], parts[2:], value)
        return
    child = parent.setdefault(key, {})
    if not isinstance(child, dict):
        child = {}
        parent[key] = child
    set_nested(child, parts[1:], value)


def set_flat_lifecycle(container, name, value):
    for prefix, handler_name, kind in (
        ("LifecyclePostStartHandlerHttpGet", "LifecyclePostStartHandler", "HttpGet"),
        ("LifecyclePostStartHandlerTcpSocket", "LifecyclePostStartHandler", "TcpSocket"),
        ("LifecyclePreStopHandlerHttpGet", "LifecyclePreStopHandler", "HttpGet"),
        ("LifecyclePreStopHandlerTcpSocket", "LifecyclePreStopHandler", "TcpSocket"),
    ):
        if name.startswith(prefix):
            field = name[len(prefix):]
            container.setdefault(handler_name, {}).setdefault(kind, {})[field] = value
            return True
    return False


def put(parts, value):
    if not parts:
        return
    if parts[0] == "Container":
        container = ensure_list(config, "Containers", int(parts[1]) - 1)
        rest = parts[2:]
        if rest and rest[0] == "EnvironmentVar":
            env = ensure_list(container, "EnvironmentVars", int(rest[1]) - 1)
            env[rest[2]] = value
            return
        if rest and rest[0] == "VolumeMount":
            mount = ensure_list(container, "VolumeMount", int(rest[1]) - 1)
            set_nested(mount, rest[2:], value)
            return
        if rest and rest[0] in {"LifecyclePostStartHandlerExec", "LifecyclePreStopHandlerExec"}:
            handler_name = (
                "LifecyclePostStartHandler"
                if rest[0].startswith("LifecyclePostStart")
                else "LifecyclePreStopHandler"
            )
            command = container.setdefault(handler_name, {}).setdefault("Exec", {}).setdefault("Command", [])
            index = int(rest[1]) - 1
            while len(command) <= index:
                command.append("")
            command[index] = value
            return
        if rest and set_flat_lifecycle(container, rest[0], value):
            return
        set_nested(container, rest, value)
        return
    if parts[0] == "InitContainer":
        container = ensure_list(config, "InitContainers", int(parts[1]) - 1)
        rest = parts[2:]
        if rest and rest[0] == "InitContainerEnvironmentVar":
            env = ensure_list(container, "EnvironmentVars", int(rest[1]) - 1)
            env[rest[2]] = value
            return
        if rest and rest[0] == "VolumeMount":
            mount = ensure_list(container, "VolumeMount", int(rest[1]) - 1)
            set_nested(mount, rest[2:], value)
            return
        set_nested(container, rest, value)
        return
    if parts[0] == "ImageRegistryCredential":
        item = ensure_list(config, "ImageRegistryCredential", int(parts[1]) - 1)
        item[parts[2]] = value
        return
    if parts[0] in {"AcrRegistryInfo", "HostAliase", "SecurityContextSysctl", "Tag", "Volume"}:
        item = ensure_list(config, parts[0], int(parts[1]) - 1)
        set_nested(item, parts[2:], value)
        return
    if parts[0] == "DnsConfigNameServer":
        config.setdefault("DnsConfig", {}).setdefault("NameServer", []).append(value)
        return
    if parts[0] == "DnsConfigSearch":
        config.setdefault("DnsConfig", {}).setdefault("Search", []).append(value)
        return
    if parts[0] == "DnsConfigOption":
        option = ensure_list(config.setdefault("DnsConfig", {}), "Option", int(parts[1]) - 1)
        option[parts[2]] = value
        return
    if parts[0] in {"InstanceType", "NtpServer"}:
        config.setdefault(parts[0], []).append(value)
        return
    set_nested(config, parts, value)


index = 0
while index < len(argv):
    flag = argv[index]
    index += 1
    if not flag.startswith("--"):
        continue
    if flag in {"--ScalingConfigurationId", "--region"}:
        if index < len(argv):
            index += 1
        continue
    if index >= len(argv):
        break
    raw_value = argv[index]
    index += 1
    put(flag[2:].split("."), scalar(flag, raw_value))

state["config"] = config
containers = config.get("Containers")
if isinstance(containers, list) and containers:
    state["image"] = containers[0].get("Image", "")
    state["envs"] = containers[0].get("EnvironmentVars", [])
with open(state_path, "w", encoding="utf-8") as stream:
    json.dump(state, stream, ensure_ascii=False, separators=(",", ":"))
    stream.write("\n")
PY
  printf '%s\n' '{"RequestId":"fake"}'
}

case "$cmd" in
  "ess ModifyScalingGroup")
    desired="$(flag_value --DesiredCapacity "$@" | tr -d '\r')"
    while (( $(jq '.instances | length' "$state" | tr -d '\r') < desired )); do
      n="$(jq '.instances | length' "$state" | tr -d '\r')"
      state_update --argjson n "$n" '.instances += [{
        "InstanceId": ("eci-new-" + ($n | tostring)),
        "PrivateIpAddress": ("10.0.0." + (240 + $n | tostring)),
        "HealthStatus": "Healthy",
        "LifecycleState": "InService"
      }]'
    done
    while (( $(jq '.instances | length' "$state" | tr -d '\r') > desired )); do
      # ESS removal policy removes the oldest instance first.
      state_update '.instances = .instances[1:]'
    done
    state_update --argjson d "$desired" '.desired = $d'
    printf '%s\n' '{"RequestId":"fake"}'
    ;;
  "ess DescribeScalingInstances")
    jq '{ScalingInstances: {ScalingInstance: [.instances[] | {
      InstanceId, PrivateIpAddress,
      HealthStatus: "Healthy",
      LifecycleState: "InService"
    }]}}' "$state"
    ;;
  "ess DescribeEciScalingConfigurations")
    describe_config
    ;;
  "ess ModifyEciScalingConfiguration")
    redact_and_log "$state_dir/modify-args.txt" "$@"
    modify_config "$@"
    ;;
  "eci DescribeContainerLog")
    jq -n --arg c "$(jq -r '.logContent // "ready"' "$state")" '{Content: $c}'
    ;;
  "eci DescribeContainerGroups")
    # Each instance gets a deterministic derived public IP (last octet of its
    # private address) so ensure_eip_in_bandwidth_package can find it.
    jq '{ContainerGroups: [.instances[] | {
      ContainerGroupId: .InstanceId,
      Status: "Running",
      InternetIp: ("203.0.113." + (.PrivateIpAddress | split(".")[3]))
    }]}' "$state"
    ;;
  "vpc DescribeEipAddresses")
    if [[ "${TOKENESS_TEST_EIP_ABSENT:-0}" == "1" ]]; then
      printf '%s\n' '{"EipAddresses":{"EipAddress":[]}}'
    else
      pkg="$(jq -r '.eip_package_id // ""' "$state" | tr -d '\r')"
      jq --arg pkg "$pkg" '{EipAddresses: {EipAddress: [.instances[] | {
        IpAddress: ("203.0.113." + (.PrivateIpAddress | split(".")[3])),
        AllocationId: ("eip-" + .InstanceId),
        BandwidthPackageId: $pkg
      }]}}' "$state"
    fi
    ;;
  "vpc AddCommonBandwidthPackageIp")
    if [[ "${TOKENESS_TEST_VPC_FAIL:-0}" == "1" ]]; then
      exit 1
    fi
    pkg="$(flag_value --BandwidthPackageId "$@" | tr -d '\r')"
    state_update --arg pkg "$pkg" '.eip_package_id = $pkg'
    printf '%s\n' '{"RequestId":"fake"}'
    ;;
  "eci DeleteContainerGroup")
    id="$(flag_value --ContainerGroupId "$@")"
    state_update --arg id "$id" '.instances |= map(select(.InstanceId != $id))'
    printf '%s\n' '{"RequestId":"fake"}'
    ;;
  *)
    printf '%s\n' '{"RequestId":"fake"}'
    ;;
esac
