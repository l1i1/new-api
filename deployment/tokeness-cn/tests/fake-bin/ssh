#!/usr/bin/env bash
set -Eeuo pipefail

# Faithful stand-in for `ssh host -- <args...>`: drop ssh options and host,
# then run the remote command locally with our inherited stdin as the remote
# process stdin. This mirrors real OpenSSH, which starts the remote command
# with the heredoc on its stdin.
#
# The argv handling is deliberately strict: real ssh JOINS its arguments into
# one remote command string that the remote shell then re-parses, so an
# argument containing whitespace or a newline splits into several words or
# even several commands there (a newline-separated IP list parks the first IP
# and runs the second as a command). This fake reproduces that by running the
# joined string through bash -c, so a caller relying on argv preservation
# fails here exactly the way it fails in production.
#
# Two additions exist for the drain-first rollout, which writes a marker to a
# NAMED host and must fail closed when a host refuses it:
#   - the target host is recovered and logged, so a test can assert which hosts
#     were pinned;
#   - TOKENESS_TEST_SSH_FAIL_HOST + TOKENESS_TEST_SSH_FAIL_ON refuse a matching
#     remote script, so the abort path is exercisable without a second host.
# Stdin is buffered to a file only when one of those knobs is active; otherwise
# it is streamed straight through as before.

args=("$@")
host=''
for ((i = 0; i < ${#args[@]}; i++)); do
  if [[ "${args[i]}" == -- ]]; then
    if ((i > 0)); then
      host="${args[i - 1]}"
    fi
    break
  fi
done
host="${host#root@}"

while [[ $# -gt 0 && "$1" != -- ]]; do
  shift
done
[[ "${1:-}" == -- ]] || exit 2
shift

stdin_file=''
if [[ -n "${TOKENESS_TEST_STATE_DIR:-}" || -n "${TOKENESS_TEST_SSH_FAIL_ON:-}" ]]; then
  stdin_file="$(mktemp)"
  cat > "$stdin_file"
fi

tag='other'
if [[ -n "$stdin_file" ]]; then
  if grep -qF 'dirname "$web_port_marker"' "$stdin_file"; then
    tag='web-port-pin'
  elif grep -qF 'dirname "$marker"' "$stdin_file"; then
    tag='marker-write'
  elif grep -qF 'rm -f -- "$1"' "$stdin_file"; then
    tag='marker-remove'
  elif grep -qF 'upstream[[:space:]]' "$stdin_file"; then
    tag='read-upstream'
  fi
fi

if [[ -n "${TOKENESS_TEST_STATE_DIR:-}" ]]; then
  mkdir -p "$TOKENESS_TEST_STATE_DIR"
  # One shared ordering log with the ESS calls (aliyun-calls.log), so a test can
  # compare line numbers instead of correlating two files.
  printf 'ssh %s %s\n' "$host" "$tag" >> "$TOKENESS_TEST_STATE_DIR/aliyun-calls.log"
fi

if [[ -n "${TOKENESS_TEST_SSH_FAIL_ON:-}" && -n "$stdin_file" ]]; then
  if [[ -z "${TOKENESS_TEST_SSH_FAIL_HOST:-}" || "$host" == "${TOKENESS_TEST_SSH_FAIL_HOST}" ]]; then
    if grep -qF "$TOKENESS_TEST_SSH_FAIL_ON" "$stdin_file"; then
      rm -f "$stdin_file"
      echo "simulated ssh failure to $host" >&2
      exit 255
    fi
  fi
fi

if [[ "${1:-}" == bash ]]; then
  # Re-join the argv the way ssh does (one command string, remote shell
  # re-parses): arguments must survive word splitting to be safe.
  joined="$*"
  if [[ -n "$stdin_file" ]]; then
    bash -c "$joined" < "$stdin_file" || exit $?
  else
    bash -c "$joined" || exit $?
  fi
elif [[ -n "$stdin_file" ]]; then
  bash -c "$1" < "$stdin_file" || exit $?
else
  bash -c "$1" || exit $?
fi

# Simulated ml-sync convergence. In production ml-sync (a 30s cron on each
# lightweight host) rewrites its own upstream copy from $DRAIN_MARKER_PATH; the
# harness has no cron, so with TOKENESS_TEST_MLSYNC=1 the same rewrite happens
# here, on the write, exactly as the real convergent loop would do it. Left off
# by default so every pre-existing case keeps its previous behaviour.
if [[ "$tag" == marker-write && "${TOKENESS_TEST_MLSYNC:-0}" == 1 \
   && -n "${DRAIN_MARKER_PATH:-}" && -n "${NGINX_CONF:-}" && -f "${NGINX_CONF:-}" ]]; then
  marker_ip="$(awk 'NR==1{print $1}' "$DRAIN_MARKER_PATH" 2>/dev/null)"
  if [[ -n "$marker_ip" ]]; then
    awk -v ip="$marker_ip" '
      /^[[:space:]]*upstream[[:space:]]+newapi_ml[[:space:]]*\{/ { inside = 1; print; next }
      inside && /^[[:space:]]*}/ { inside = 0 }
      inside && /^[[:space:]]*server[[:space:]]+[0-9.]+:/ {
        sub(/[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/, ip); print; next
      }
      { print }
    ' "$NGINX_CONF" > "$NGINX_CONF.mlsync-tmp" && mv "$NGINX_CONF.mlsync-tmp" "$NGINX_CONF"
  fi
fi

# Simulated ecs-fleet-sync on the entry host (the relay tier's real consumer,
# a 60s cron): the ECS relay upstream is DERIVED from the live instance view
# minus the drain file - never hand-seeded by the test. Before this, a case
# could pre-write the upstream with instances that did not exist and the
# release's "the relay carries the new instance" gate would pass on that
# pre-filled text; nothing tied the upstream to the drain file or to the ESS
# state at all. The v2 marker's IP lines (3rd line on) are the parked set; the
# owner and lease lines are not IPs. RELAY_MAX_MEMBERS truncates like the real
# sync's `head -n MAX_MEMBERS`. TOKENESS_TEST_FLEET_SYNC_OFF=1 models a stuck
# sync: the upstream stops tracking reality and the release must fail closed.
if [[ "${TOKENESS_TEST_MLSYNC:-0}" == 1 && -n "${ECS_UPSTREAM_CONF:-}" \
   && -n "${TOKENESS_TEST_STATE_DIR:-}" && -f "$TOKENESS_TEST_STATE_DIR/state.json" \
   && "${TOKENESS_TEST_FLEET_SYNC_OFF:-0}" != 1 ]]; then
  fleet_tmp="$(mktemp "$ECS_UPSTREAM_CONF.fsync.XXXXXX")"
  if jq -r --argjson cap "${RELAY_MAX_MEMBERS:-10}" '
      [ .instances[]? | select(.LifecycleState == "InService") | .PrivateIpAddress ] as $all
      | ($all | length) as $total
      | (if $total > $cap then $all[0:$cap] else $all end) as $kept
      | ([ ($kept[]) ]) | sort | .[]' "$TOKENESS_TEST_STATE_DIR/state.json" > "$fleet_tmp.body" 2>/dev/null; then
    : > "$fleet_tmp"
    # IP lines only (v2 marker: owner/lease first). A parked instance is
    # subtracted even while it is still in .instances: that is the whole point
    # of the file.
    if [[ -n "${SHRINK_DRAIN_PATH:-}" && -f "$SHRINK_DRAIN_PATH" ]]; then
      grep -E '^10\.0\.0\.[0-9]+$' "$SHRINK_DRAIN_PATH" > "$fleet_tmp.parked" 2>/dev/null || : > "$fleet_tmp.parked"
    else
      : > "$fleet_tmp.parked"
    fi
    while IFS= read -r fleet_ip; do
      [ -n "$fleet_ip" ] || continue
      fleet_ip="${fleet_ip//$'\r'/}"
      [ -n "$fleet_ip" ] || continue
      grep -qxF "$fleet_ip" "$fleet_tmp.parked" && continue
      printf 'server %s:3000;\n' "$fleet_ip" >> "$fleet_tmp"
    done < "$fleet_tmp.body"
    mv -f -- "$fleet_tmp" "$ECS_UPSTREAM_CONF"
  fi
  rm -f -- "$fleet_tmp.body" "$fleet_tmp.parked" "$fleet_tmp" 2>/dev/null || true
fi

# Simulated web-primary convergence for the blue-green master: production
# ml-sync adopts the pinned port (health-gated) on its 30s cron; here the
# rewrite happens on the pin write itself.
if [[ "$tag" == web-port-pin && "${TOKENESS_TEST_MLSYNC:-0}" == 1 \
   && -n "${WEB_PRIMARY_MARKER_PATH:-}" && -n "${NGINX_CONF:-}" && -f "${NGINX_CONF:-}" ]]; then
  pin_port="$(awk 'NR==1{print $1}' "$WEB_PRIMARY_MARKER_PATH" 2>/dev/null)"
  if [[ "$pin_port" =~ ^[0-9]+$ ]]; then
    awk -v port="$pin_port" '
      /^[[:space:]]*upstream[[:space:]]+newapi_web[[:space:]]*\{/ { inside = 1; print; next }
      inside && /^[[:space:]]*}/ { inside = 0 }
      inside && /^[[:space:]]*server[[:space:]]+[0-9.]+:[0-9]+/ && !/backup/ {
        sub(/:[0-9]+/, ":" port); print; next
      }
      { print }
    ' "$NGINX_CONF" > "$NGINX_CONF.mlsync-tmp" && mv "$NGINX_CONF.mlsync-tmp" "$NGINX_CONF"
  fi
fi

exit 0
