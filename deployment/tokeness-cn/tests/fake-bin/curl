#!/usr/bin/env bash
set -Eeuo pipefail

url=''
for arg in "$@"; do
  case "$arg" in
    http://*|https://*)
      url="$arg"
      break
      ;;
  esac
done
[[ -n "$url" ]] || exit 2
if [[ "$url" == *"/service/token"* ]]; then
  printf '%s\n' '{"token":"fake-registry-token"}'
elif [[ "$url" == *"/manifests/"* ]]; then
  # resolve_ml_digest reads the Docker-Content-Digest header via `curl -D -`.
  printf 'docker-content-digest: %s\r\n' "${TOKENESS_TEST_ML_DIGEST:-sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc}"
elif [[ "$url" == "${EDGEONE_TEST_URL:-https://tokeness.cn/api/status}" ]]; then
  [[ "${TOKENESS_TEST_PUBLIC_FAIL:-0}" -eq 0 ]] || exit 22
  printf '%s\n' "${TOKENESS_TEST_PUBLIC_BODY:-{\"success\":true}}"
elif [[ "$url" == *":3000/api/status" || "$url" == *":3001/api/status" ]]; then
  # Master container version probe (sync_master_container). The master lives on
  # the backup entry ECS and is rolled blue-green across the 3000/3001 port
  # pair, so the probe lands on whichever port the green container serves.
  printf '{"data":{"version":"%s"}}\n' "${TOKENESS_TEST_HOST_VERSION:-}"
else
  [[ "${TOKENESS_TEST_DIRECT_FAIL:-0}" -eq 0 ]] || exit 22
  printf '%s\n' "${TOKENESS_TEST_DIRECT_BODY:-{\"success\":true}}"
fi
