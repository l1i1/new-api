#!/usr/bin/env bash
# ecs-shrink-guard - graceful scale-in for the China ECI tier, run from the
# entry host by cron.
#
# Why this exists: an ESS alarm can only call a simple scaling rule, which
# retires an instance the moment it fires. The app then has APP_SHUTDOWN_TIMEOUT
# (180s) to finish in-flight work before the platform's 240s grace kills the
# container - and 7.2% of this tier's requests run longer than 180 seconds
# (p99 765s, max 2132s; measured over 393,800 requests on 2026-10-09), so an
# alarm-driven scale-in cuts live streams. The release path avoids this with a
# 1900s drain-first hold; this script gives the automatic path the same
# treatment:
#
#   1. only when the tier has been idle long enough (no release running, request
#      rate below IDLE_RPM for IDLE_MINUTES),
#   2. park the oldest instance in DRAIN_FILE (the v2 leased marker protocol:
#      line 1 owner, line 2 lease expiry, then IPs), which ecs-fleet-sync
#      subtracts from the relay upstream list within a minute - so it stops
#      receiving new requests while its in-flight streams finish,
#   3. wait DRAIN_SECONDS, re-verify the victim is still the instance we parked,
#      then ask ESS for one fewer instance. ESS's OldestInstance removal policy
#      picks the parked instance,
#   4. keep the marker parked until the victim has left the group ENTIRELY (a
#      member still in Removing is a removal in flight), then clear it.
#
# It never goes below MIN_KEEP instances, never acts while /etc/ml-sync/shrink-hold
# is fresh (deploy.sh writes it for the duration of a release), and only ever
# clears a drain marker it owns: the release parks its own retire set in the
# same file, and deleting a foreign marker mid-window would send new requests
# back to an instance that is being retired.
#
# Every decision is logged to LOG; run with --dry-run to print what it would do.
set -Eeuo pipefail

# The path is pinned for cron determinism; SHRINK_PATH exists only so the test
# harness can prepend its fake-bin directory. Production never sets it.
PATH="${SHRINK_PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}"
export PATH

GROUP="${SCALING_GROUP_ID:-asg-uf641n1j5akwa1ozcz6t}"
REGION="${ALIYUN_REGION:-cn-shanghai}"
MIN_KEEP="${SHRINK_MIN_KEEP:-2}"
IDLE_RPM="${SHRINK_IDLE_RPM:-300}"          # requests/minute below which the tier counts as idle
IDLE_MINUTES="${SHRINK_IDLE_MINUTES:-60}"   # how long it must stay idle before shrinking
RATE_WINDOW_SECONDS="${SHRINK_RATE_WINDOW:-900}"
DRAIN_SECONDS="${SHRINK_DRAIN_SECONDS:-1900}"  # same hold the release uses
DRAIN_FILE="${SHRINK_DRAIN_FILE:-/etc/ml-sync/shrink-drain}"
HOLD_FILE="${SHRINK_HOLD_FILE:-/etc/ml-sync/shrink-hold}"
STATE_FILE="${SHRINK_STATE_FILE:-/var/lib/ml-sync/shrink-state.json}"
LOG="${SHRINK_LOG:-/var/log/ecs-shrink-guard.log}"
# Rotation: logrotate moves the current file to .1, and a 15-minute window that
# straddles a rotation must still be counted in full - reading only the current
# file right after a rotation reports a near-zero rate, which the idle test below
# would read as "safe to shrink" while the tier is busy. Count both.
ACCESS_LOGS="${SHRINK_ACCESS_LOGS:-/var/log/nginx/access.log /var/log/nginx/access.log.1}"
LOCK_FILE="${SHRINK_LOCK_FILE:-/var/lock/ecs-shrink-guard.lock}"
# A release that is SIGKILLed (CNB cancelled two of them on 2026-10-09) never
# runs its EXIT trap, so its hold file survives and would keep the guard off
# forever. Past this age the hold is treated as abandoned.
HOLD_MAX_AGE="${SHRINK_HOLD_MAX_AGE:-21600}"
# The v2 drain marker's lease. The guard renews its own marker every tick while
# a drain or a removal wait is in flight; a lease this far past expiry means the
# writer is gone, and anyone may collect the marker.
DRAIN_LEASE_SECONDS="${SHRINK_DRAIN_LEASE_SECONDS:-$(( DRAIN_SECONDS + 900 ))}"
# How many 15s polls to wait for the retired instance to leave the group
# entirely (Removing -> gone) before giving the next tick the job.
REMOVAL_POLLS="${SHRINK_REMOVAL_POLLS:-20}"
DRY_RUN=0
[[ "${1:-}" == "--dry-run" ]] && DRY_RUN=1
# The guard's identity on the drain marker (v2 line 1).
DRAIN_OWNER="shrink-guard:$(hostname 2>/dev/null || printf host)"

hold_is_stale() {
  local written age epoch
  written="$(head -1 "$HOLD_FILE" 2>/dev/null | tr -d ' \r')"
  [[ -n "$written" ]] || return 1
  # Unparsable means we cannot prove the release is dead, and guessing "stale"
  # here would let the guard shrink the tier during that release - the dangerous
  # direction. Treat it as a live hold and leave the tier alone.
  epoch="$(date -d "$written" +%s 2>/dev/null)" || return 1
  (( epoch > 0 )) || return 1
  age=$(( $(date +%s) - epoch ))
  (( age > HOLD_MAX_AGE ))
}

# Must always return 0: under `set -e` a bare `log "..."` whose last command is a
# false [[ ]] test terminates the whole run, which is how the first version of
# this script exited before doing anything at all.
log() {
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG" 2>/dev/null || true
  if [[ "$DRY_RUN" == 1 ]]; then printf '%s\n' "$*"; fi
  return 0
}
logrotate_local() { [[ -f "$LOG" ]] || return 0; [[ "$(wc -l <"$LOG")" -gt 2000 ]] || return 0; tail -n 1000 "$LOG" >"$LOG.tmp" && mv -f "$LOG.tmp" "$LOG"; }

aliyun_ess() { aliyun ess "$@" --region "$REGION" 2>/dev/null; }
instances_json() { aliyun_ess DescribeScalingInstances --ScalingGroupId "$GROUP"; }
in_service_count() {
  instances_json \
    | jq -r '[.ScalingInstances.ScalingInstance[]? | select(.LifecycleState=="InService" and .HealthStatus=="Healthy")] | length' 2>/dev/null | tr -d '\r'
}
desired_count() {
  aliyun_ess DescribeScalingGroups --ScalingGroupId "$GROUP" \
    | jq -r '.ScalingGroups.ScalingGroup[0].DesiredCapacity // empty' 2>/dev/null | tr -d '\r'
}
# The victim the guard may retire: the OLDEST in-service instance, and only when
# the group's removal policy and single-zone layout make age order predict what
# ESS will actually remove. Prints "id ip" or nothing.
oldest_victim() {
  local policies zones
  policies="$(aliyun_ess DescribeScalingGroups --ScalingGroupId "$GROUP" \
    | jq -r '[.ScalingGroups.ScalingGroup[0].RemovalPolicies.RemovalPolicy[]?] | join(",")' 2>/dev/null | tr -d '\r')" || policies=""
  if [[ "$policies" != "OldestInstance" ]]; then
    log "ERROR: the group's removal policy is '${policies:-unknown}', not OldestInstance; cannot predict the scale-in victim"
    return 1
  fi
  zones="$(instances_json | jq -r '[.ScalingInstances.ScalingInstance[]? | select(.LifecycleState=="InService") | .ZoneId] | unique | length' 2>/dev/null | tr -d '\r')" || zones=""
  if [[ "$zones" != "1" ]]; then
    log "ERROR: in-service instances span ${zones:-?} zone(s); age order does not predict the victim"
    return 1
  fi
  instances_json | jq -r '[.ScalingInstances.ScalingInstance[]? | select(.LifecycleState=="InService" and .HealthStatus=="Healthy")]
    | sort_by(.CreatedTime) | .[0] | "\(.InstanceId) \(.PrivateIpAddress // empty)"' 2>/dev/null | tr -d '\r'
}
victim_id_of() {  # <ip> -> the id the group currently reports for that ip
  instances_json | jq -r --arg ip "$1" '[.ScalingInstances.ScalingInstance[]? | select(.PrivateIpAddress==$ip)]
    | .[0] | .InstanceId // empty' 2>/dev/null | tr -d '\r'
}
victim_gone() {  # <id> -> 0 when the group no longer reports the id at all
  local n
  n="$(instances_json | jq -r --arg id "$1" '[.ScalingInstances.ScalingInstance[]? | select(.InstanceId==$id)] | length' 2>/dev/null | tr -d '\r')"
  [[ "$n" == "0" ]]
}
# Requests served in the last RATE_WINDOW_SECONDS, straight from the relay's own
# access log - no metrics API round trip, and it counts what the tier actually did.
# Comparable zero-padded key (YYYYmmddHHMMSS) instead of a formatted date string:
# the old version compared "10/Oct/2026:01:26:10" lexically, which silently
# breaks across a month or year boundary, and it assumed gawk for date maths -
# this host's awk is mawk.
recent_requests() {
  local since_key total=0 f
  since_key="$(date -d "@$(( $(date +%s) - RATE_WINDOW_SECONDS ))" '+%Y%m%d%H%M%S' 2>/dev/null)" || since_key=""
  [[ -n "$since_key" ]] || { printf '0\n'; return 0; }
  for f in $ACCESS_LOGS; do
    [[ -r "$f" ]] || continue
    total=$(( total + $(awk -v since="$since_key" '
      BEGIN { split("Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec", mo, " "); for (i = 1; i <= 12; i++) mon[mo[i]] = i }
      {
        ts = substr($4, 2); split(ts, a, "[:/]")
        if (!(a[2] in mon)) next
        key = sprintf("%04d%02d%02d%02d%02d%02d", a[3], mon[a[2]], a[1], a[4], a[5], a[6])
        if (key >= since) n++
      }
      END { print n+0 }' "$f" 2>/dev/null) ))
  done
  printf '%s\n' "$total"
}
state_get() { [[ -f "$STATE_FILE" ]] && jq -r --arg k "$1" '.[$k] // empty' "$STATE_FILE" 2>/dev/null | tr -d '\r' || true; }
state_set() {
  if [[ "$DRY_RUN" == 1 ]]; then log "dry run: would set $1=$2"; return 0; fi
  local tmp; tmp="$(mktemp)"
  if [[ -f "$STATE_FILE" ]]; then jq --arg k "$1" --arg v "$2" '.[$k] = $v' "$STATE_FILE" >"$tmp" 2>/dev/null || printf '{"%s":"%s"}\n' "$1" "$2" >"$tmp"; else printf '{"%s":"%s"}\n' "$1" "$2" >"$tmp"; fi
  mv -f "$tmp" "$STATE_FILE"
}

# --- v2 drain marker helpers (owner line, lease line, IPs) -------------------
marker_ours() {
  local found
  found="$(sed -n '1p' "$DRAIN_FILE" 2>/dev/null | tr -d ' \r' || true)"
  [[ "$found" == "$DRAIN_OWNER" ]]
}
marker_has_ip() { grep -qxF "$1" "$DRAIN_FILE" 2>/dev/null; }
marker_lease_expired() {
  local lease
  lease="$(sed -n '2p' "$DRAIN_FILE" 2>/dev/null | tr -d ' \r' || true)"
  [[ "$lease" =~ ^[0-9]+$ ]] || return 1
  (( $(date +%s) >= lease ))
}
# write_marker <ip>: rewrite OUR marker with a fresh lease, atomically.
write_marker() {
  if [[ "$DRY_RUN" == 1 ]]; then log "dry run: would park $1 in $DRAIN_FILE"; return 0; fi
  local tmp
  tmp="$(mktemp "${DRAIN_FILE}.tmp.XXXXXX")"
  {
    printf '%s\n' "$DRAIN_OWNER"
    printf '%s\n' "$(( $(date +%s) + DRAIN_LEASE_SECONDS ))"
    printf '%s\n' "$1"
  } >"$tmp"
  chmod 0644 "$tmp"
  mv -f -- "$tmp" "$DRAIN_FILE"
}
# clear_marker: remove OUR marker, or a foreign one whose lease has lapsed. A
# foreign marker with a live lease belongs to a release mid-drain; deleting it
# would send new requests to the instance that release is retiring.
clear_marker() {
  if [[ "$DRY_RUN" == 1 ]]; then log "dry run: would clear the drain marker"; return 0; fi
  [[ -f "$DRAIN_FILE" ]] || { state_set draining ""; state_set drain_until ""; state_set draining_id ""; return 0; }
  if marker_ours || marker_lease_expired; then
    rm -f "$DRAIN_FILE" && log "drain marker cleared"
  else
    log "drain marker belongs to $(sed -n '1p' "$DRAIN_FILE" | tr -d ' \r') with a live lease; leaving it"
  fi
  state_set draining ""; state_set drain_until ""; state_set draining_id ""
  return 0
}
# release_our_drain: the release owns the tier; drop OUR parking and state, but
# never touch a marker that no longer names our victim (the release may have
# taken the file over since our last tick).
release_our_drain() {
  local ours
  ours="$(state_get draining)"
  if [[ -n "$ours" ]] && [[ -f "$DRAIN_FILE" ]] && marker_ours && marker_has_ip "$ours"; then
    clear_marker
    log "release hold present; releasing our in-flight drain so the release owns the tier"
  else
    if [[ -n "$ours" || -n "$(state_get drain_until)" ]]; then
      log "release hold present; our drain marker was taken over; dropping state without touching the file"
    fi
    state_set draining ""; state_set drain_until ""; state_set draining_id ""
  fi
  return 0
}

[[ "$DRY_RUN" == 1 ]] && log "--- dry run ---" || true

# cron can start a second run while the first is still inside its verification
# poll (up to 5 minutes), and two runs each deciding to shrink would retire two
# instances for one idle period. Fail fast rather than queue: the next tick is
# five minutes away.
exec 9>"$LOCK_FILE"
if ! flock -n 9; then log "another run holds the lock; skipping this tick"; exit 0; fi

# Janitor (H6): a marker that is not ours and whose lease has lapsed is the
# leftover of a SIGKILLed writer (a release's EXIT trap never ran). The consumer
# may already ignore it once the lease is parsed, but this host's fleet-sync and
# any operator reading the file deserve a clean state. Runs BEFORE the hold
# check on purpose: a killed release leaves its hold behind for up to
# HOLD_MAX_AGE, and the marker must not wait that long.
if [[ -f "$DRAIN_FILE" ]] && ! marker_ours && marker_lease_expired; then
  log "WARN: drain marker at $DRAIN_FILE is not ours and its lease has lapsed; removing it as abandoned"
  rm -f "$DRAIN_FILE" 2>/dev/null || true
fi

# A release owns the tier for its whole duration: it grows and steps the group
# down on its own schedule and already drains the instances it retires.
if [[ -f "$HOLD_FILE" ]] && hold_is_stale; then
  log "WARN: shrink hold at $HOLD_FILE is older than ${HOLD_MAX_AGE}s; treating it as abandoned (a killed release left it behind) and continuing"
  rm -f "$HOLD_FILE" 2>/dev/null || true
fi
if [[ -f "$HOLD_FILE" ]]; then
  release_our_drain
  state_set idle_streak 0
  log "release hold present ($HOLD_FILE); not shrinking"; exit 0
fi

# Resume an in-flight drain BEFORE the capacity floor check: the tier is already
# short one member in the relay list, so finish or undo it. Checking the floor
# first would strand a drain forever once the tier sat at MIN_KEEP.
if [[ -n "$(state_get drain_until)" || -n "$(state_get retiring)" ]]; then
  if [[ -n "$(state_get retiring)" ]]; then
    # Phase 2: removal was requested; wait for the victim to leave the group
    # ENTIRELY (Removing -> gone). A member still reported in any lifecycle
    # state is a removal in flight; un-parking now would send it new requests.
    rid="$(state_get retiring)"
    rip="$(state_get draining)"
    if victim_gone "$rid"; then
      log "retired $rid ($rip) left the group; clearing the drain marker"
      clear_marker
      exit 0
    fi
    # Keep the marker parked and its lease fresh while the removal settles.
    if [[ -f "$DRAIN_FILE" ]] && marker_ours && [[ -n "$rip" ]] && marker_has_ip "$rip"; then
      write_marker "$rip"
    else
      log "WARN: our drain marker vanished mid-removal; $rid may receive new requests until it is gone"
    fi
    log "waiting for $rid to leave the group (still reported)"
    exit 0
  fi
  until_ts="$(state_get drain_until)"
  if (( $(date +%s) < until_ts )); then
    # Renew the lease every tick while the drain window runs.
    rip="$(state_get draining)"
    if [[ -f "$DRAIN_FILE" ]] && marker_ours && [[ -n "$rip" ]] && marker_has_ip "$rip"; then
      write_marker "$rip"
    fi
    log "draining $(state_get draining) for another $(( until_ts - $(date +%s) ))s"; exit 0
  fi
  drained="$(state_get draining)"
  rid="$(state_get draining_id)"
  # The victim must still be the instance we parked (#8): if it failed, was
  # replaced, or left the group during the window, shrinking anyway would let
  # ESS remove a DIFFERENT, never-parked instance - the exact streams this
  # drain exists to protect.
  if [[ -z "$rid" ]]; then
    rid="$(victim_id_of "$drained")"
  fi
  still="$(instances_json | jq -r --arg id "$rid" --arg ip "$drained" '[.ScalingInstances.ScalingInstance[]? | select(.InstanceId==$id and .PrivateIpAddress==$ip and .LifecycleState=="InService" and .HealthStatus=="Healthy")] | length' 2>/dev/null | tr -d '\r')"
  if [[ "$still" != "1" ]]; then
    log "victim $rid ($drained) is no longer the healthy in-service instance we parked; ending this drain without shrinking"
    clear_marker; state_set idle_streak 0; exit 0
  fi
  # The marker must still be OURS and still park the victim: a release may have
  # taken the file over, and shrinking while its marker names something else
  # would remove an instance nobody parked.
  if ! marker_ours || ! marker_has_ip "$drained"; then
    log "drain marker no longer parks $drained (owner: $(sed -n '1p' "$DRAIN_FILE" 2>/dev/null | tr -d ' \r')); ending this drain without shrinking"
    state_set draining ""; state_set drain_until ""; state_set draining_id ""; state_set idle_streak 0
    exit 0
  fi
  # The tier may have started serving again while we waited - the scale-out alarm
  # fires on its own. Shrinking into a ramp is the same mistake in the other
  # direction, so the idle test runs again before anything is removed.
  recent_now="$(recent_requests)"; rpm_now=$(( recent_now * 60 / RATE_WINDOW_SECONDS ))
  if (( rpm_now > IDLE_RPM )); then
    log "load returned during the drain (${rpm_now} req/min > $IDLE_RPM); releasing the drain without shrinking"
    clear_marker; state_set idle_streak 0; exit 0
  fi
  # Re-check the release hold RIGHT BEFORE asking ESS to remove an instance:
  # a release can start between this tick's earlier check and now (#7).
  if [[ -f "$HOLD_FILE" ]] && ! hold_is_stale; then
    log "release hold appeared during the drain; standing down"
    clear_marker; state_set idle_streak 0; exit 0
  fi
  instances="$(in_service_count)"; instances="${instances:-0}"
  target=$(( instances - 1 ))
  (( target < MIN_KEEP )) && target="$MIN_KEEP"
  log "drain window over for $rid ($drained); asking ESS for $target instance(s)"
  if (( DRY_RUN == 1 )); then log "dry run: would set DesiredCapacity=$target"; clear_marker; exit 0; fi
  if aliyun_ess ModifyScalingGroup --ScalingGroupId "$GROUP" --DesiredCapacity "$target" >/dev/null; then
    log "DesiredCapacity set to $target; waiting for $rid to leave the group"
    state_set retiring "$rid"
    for _ in $(seq 1 "$REMOVAL_POLLS"); do
      if victim_gone "$rid"; then break; fi
      sleep "${SHRINK_REMOVAL_POLL_SECONDS:-15}"
    done
    if victim_gone "$rid"; then
      log "after shrink: $rid left the group"
      clear_marker
      exit 0
    fi
    log "removal of $rid still in flight after $(( REMOVAL_POLLS * ${SHRINK_REMOVAL_POLL_SECONDS:-15} ))s; next tick keeps waiting"
    exit 0
  else
    log "ERROR: ModifyScalingGroup failed; the tier keeps $instances instance(s)"
    clear_marker
    exit 0
  fi
fi

instances="$(in_service_count)"; instances="${instances:-0}"
desired="$(desired_count)"; desired="${desired:-0}"
if (( instances <= MIN_KEEP )); then log "at or below the floor ($instances <= $MIN_KEEP); nothing to do"; exit 0; fi

# Idle test: a busy tier resets the streak, so shrinking only ever happens after
# a sustained quiet period (the same signal the release's drain holds wait for).
recent="$(recent_requests)"
rpm=$(( recent * 60 / (RATE_WINDOW_SECONDS > 0 ? RATE_WINDOW_SECONDS : 1) ))
if (( rpm > IDLE_RPM )); then
  log "busy: ${rpm} req/min over the last $(( RATE_WINDOW_SECONDS / 60 )) min (limit $IDLE_RPM); idling streak reset"
  state_set idle_streak 0
  exit 0
fi

streak=$(( $(state_get idle_streak || echo 0) + 1 ))
state_set idle_streak "$streak"
needed=$(( (IDLE_MINUTES * 60 + 299) / 300 ))   # cron runs every 5 minutes
if (( streak < needed )); then log "idle ${rpm} req/min, streak $streak/$needed; waiting"; exit 0; fi

victim="$(oldest_victim || true)"
if [[ ! "$victim" =~ ^[a-zA-Z0-9-]+[[:space:]]10\.0\.0\.[0-9]+$ ]]; then
  log "ERROR: could not resolve a parkable victim (got '$victim'); not shrinking this tick"
  state_set idle_streak 0
  exit 0
fi
victim_id="$(printf '%s' "$victim" | awk '{print $1}')"
victim_ip="$(printf '%s' "$victim" | awk '{print $2}')"
if (( DRY_RUN == 1 )); then log "dry run: idle $streak checks, would drain $victim_id ($victim_ip) then shrink to $(( instances - 1 ))"; exit 0; fi

write_marker "$victim_ip"
state_set draining "$victim_ip"
state_set draining_id "$victim_id"
state_set drain_until "$(( $(date +%s) + DRAIN_SECONDS ))"
state_set idle_streak 0
log "idle for $(( needed * 5 )) min; parked $victim_id ($victim_ip) in $DRAIN_FILE (relay drops it within a minute) and will wait ${DRAIN_SECONDS}s for in-flight streams before shrinking"
logrotate_local
