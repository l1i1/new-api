#!/usr/bin/env bash
set -Eeuo pipefail

host=''
for argument in "$@"; do
  if [[ "$argument" == root@* ]]; then
    host="${argument#root@}"
  fi
done
command="${*: -1}"

printf '%s|%s\n' "$host" "$command" >> "$TOKENESS_TEST_LOG"

readonly OLD_IMAGE='ghcr.io/l1i1/new-api@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
readonly MUTABLE_IMAGE='ghcr.io/l1i1/new-api:legacy'
state_file="$TOKENESS_TEST_STATE_DIR/$host"
if [[ ! -f "$state_file" ]]; then
  printf '%s\n' "$OLD_IMAGE" > "$state_file"
fi

selected="$(<"$state_file")"
version='v-test-old'
health='healthy'

if [[ "$command" == verify && "$host" == "${TOKENESS_TEST_MUTABLE_HOST:-}" ]]; then
  selected="$MUTABLE_IMAGE"
elif [[ "$command" == deploy\ * ]]; then
  requested="${command#deploy }"
  if [[ "$host" == "${TOKENESS_TEST_FAIL_HOST:-}" && "${TOKENESS_TEST_MODE:-}" == 'noop-result' && "$requested" != "$OLD_IMAGE" ]]; then
    selected="$(<"$state_file")"
  else
    selected="$requested"
    printf '%s\n' "$selected" > "$state_file"
  fi
fi

if [[ "$selected" != "$OLD_IMAGE" && "$selected" != "$MUTABLE_IMAGE" ]]; then
  version='v-test-new'
fi
if [[ "$command" == deploy\ * && "$selected" != "$OLD_IMAGE" && \
  "${TOKENESS_TEST_UNHEALTHY_TARGET:-0}" -eq 1 ]]; then
  health='unhealthy'
fi

if [[ "$host" == "${TOKENESS_TEST_FAIL_HOST:-}" && "$command" == deploy\ * ]]; then
  if [[ "${TOKENESS_TEST_MODE:-}" == 'disconnect-both' || \
    ("${TOKENESS_TEST_MODE:-}" == 'disconnect-after-apply' && "$selected" != "$OLD_IMAGE") ]]; then
    exit 255
  fi
fi

printf 'TOKENESS_RESULT\t%s\t%s\trunning\t%s\t2026-07-27T00:00:00Z\t%s\n' \
  "$selected" "$selected" "$health" "$version"
