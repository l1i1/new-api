#!/usr/bin/env bash
set -Eeuo pipefail

headers=''
body=''
while [[ $# -gt 0 ]]; do
  case "$1" in
    -D)
      headers="$2"
      shift 2
      ;;
    -o)
      body="$2"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

version='v-test-new'
if [[ "${TOKENESS_TEST_CDN_FAILURE:-0}" -eq 1 ]]; then
  version='v-test-old'
fi

url="${*: -1}"
status='401'
response='{"error":"unauthorized"}'
if [[ "$url" != */v1/models* ]]; then
  status='200'
  response='{"success":true,"data":{"version":"v-test-new"}}'
fi
if [[ "${TOKENESS_TEST_WEB_FAILURE:-0}" -eq 1 && "$url" != */v1/models* ]]; then
  status='503'
  response='{"success":false}'
fi
printf 'HTTP/2 %s\r\nX-New-Api-Version: %s\r\n\r\n' "$status" "$version" > "$headers"
printf '%s\n' "$response" > "$body"
printf '%s' "$status"
